{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: run active file",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${fileBasename}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "uv: sync",
      "type": "shell",
      "command": "uv",
      "args": ["sync"],
      "problemMatcher": []
    },
    {
      "label": "uv: Build Editor",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${workspaceFolder}/BUILD_EDITOR.py"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "run: Editor",
      "type": "shell",
      "command": "${cwd}/EDITOR/Rengin_Editor",
      "args": [""],
    }
  ]
}   